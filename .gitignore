# Swift build artefacts
.build/
*.o
*.d

# SQLite databases written by the engine at runtime
*.sqlite
*.sqlite-shm
*.sqlite-wal

# Xcode user state (these are machine-local)
xcuserdata/
*.xcuserstate
*.xcbkptlist
DerivedData/

# Claude Code worktrees
.claude/worktrees/

# SwiftPM Xcode integration
.swiftpm/

# macOS metadata
.DS_Store

# Editor
.idea/
*.swp
/SemelCore/.swiftpm/xcode/xcuserdata/jadeburton.xcuserdatad/xcschemes/xcschememanagement.plist
/.swiftpm/xcode/xcuserdata/jadeburton.xcuserdatad/xcschemes/xcschememanagement.plist

# End-to-end fixtures: what the harness prepares in its /tmp copy, kept out in case
# anyone runs prepare in the tree itself. A fixture's own semel.config is committed, as
# a project's is; MyApp's is prepare's to write.
EndToEnd/Fixtures/swift/MyApp/semel.config
EndToEnd/Fixtures/**/Dependencies/

# The machine's half of any configuration (B-109): written by `semel-clang` or
# `semel-swift prepare`, one machine's facts, never committed
semel.machine.config

# What `semel-swift prepare` vendors at the root when Semel builds itself in place (B-78):
# GRDB at the commit Package.resolved pins. The roster builds a copy and vendors there.
# The lock `prepare` writes beside the copy is meant to be checked in (B-06).
/Dependencies/*
!/Dependencies/*.semel-lock
