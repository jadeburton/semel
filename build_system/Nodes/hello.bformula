let clang = VersionConfig(
    tool: "clang"
)

hello.dylib = LinkExec(inputs: [
                           "toolchain": clang
                           "objects": Compile(inputs: [
                                                         Preprocessor(tool: "clang",
                                                                      inputs: ["sources": [Source(path: "hello.c"), Source(path: "hello.h"), Source(path: "common.h")]])
                                             ])
                     ])
