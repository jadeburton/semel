// The formula docs/tutorial/first-node.md ends with. `include 'clang'` brings the funcs
// SemelClang provides; each wires a preprocessor and a compiler per source file into a
// linker, every tool selecting its own settings out of the shared config file.

include 'clang'

product "hello.dylib" = clang.dynamicLibrary(sources: <src>, settings: <../clang.cfg>)
product "hello" = clang.executable(sources: <src>, settings: <../clang.cfg>)

// The whole file, not a subset — this product exists to show what was pushed.
product "config.txt" = StaticFile(path: <../clang.cfg>)

// One wire per source file, named by the formula: `%%f.0%%` is what the `*` matched and the
// `.c` after it is literal, so the names are `hello.c`, not the path the tree happens to be
// mounted at — a path in the name would be a path in the product.
product "lines.txt" = LineCounter(input: [{f: <src/*.c>} "%%f.0%%.c": StaticFile(path: f)])
