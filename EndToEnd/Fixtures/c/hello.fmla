// A C library and an executable from the same sources. `include 'clang'` brings the
// funcs SemelClang provides: each takes the folder of sources and the settings file, and
// wires the preprocessor, compiler and linker — each selecting its own settings out of the
// file by the prefix its node type reads — so this formula does not.

include 'clang'

product "hello.dylib" = clang.dynamicLibrary(sources: <src>, settings: <../clang.cfg>)
product "hello" = clang.executable(sources: <src>, settings: <../clang.cfg>)

// The whole file, not a subset — this product exists to show what was pushed.
product "config.txt" = StaticFile(path: <../clang.cfg>)
