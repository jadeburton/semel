// Written by semel-swift prepare for --platform ios-simulator: the project's choices —
// the target at the deployment version the manifests declare, and for the clang
// tools a language standard to start from. Yours to edit and check in. The machine's
// tools and SDK are in semel.machine.config beside this file, which prepare
// rewrites.

apple.assetCatalogCompiler.platform=iphonesimulator
apple.assetCatalogCompiler.minimumDeploymentTarget=18.0
apple.assetCatalogCompiler.targetDevices=iphone,ipad

apple.ibToolCompiler.minimumDeploymentTarget=18.0
apple.ibToolCompiler.targetDevices=iphone,ipad

clang.compiler.target=arm64-apple-ios18.0-simulator
// prepare's starting point, not clang's default: the project's choice of standard
clang.compiler.cStandard=gnu11
clang.compiler.cxxStandard=c++17

clang.preprocessor.target=arm64-apple-ios18.0-simulator
// prepare's starting point, not clang's default: the project's choice of standard
clang.preprocessor.cStandard=gnu11
clang.preprocessor.cxxStandard=c++17

swift.compiler.target=arm64-apple-ios18.0-simulator

swift.linker.target=arm64-apple-ios18.0-simulator
