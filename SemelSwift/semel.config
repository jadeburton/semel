# This is the config Semel builds itself with.
#
# This tree is a Swift project only, so only the swift.* namespaces appear here.
# A Clang project would supply its own clang.* settings from its own semel.config.
#
# There are six byte-identical copies of this file in this tree, one beside each
# Package.swift. Every package discovered in the input file system is configured by the
# file beside it, and configuration does not inherit -- no ancestor walk, no nearest-wins
# -- so a package with no file next to it fails every node it contains. Copying is the
# composition mechanism the design chose; SelfBuildConfigTests checks all six against
# each other and against what the tool types actually require.
#
# There are no default values anywhere in Semel: every setting a node needs is written
# here once, under that node's namespace, or the build fails naming the missing key.
# moduleName and outputName are not here, on purpose: those come from the package
# manifest through node properties, and a config file must not be able to override
# what a target already is.
#
# toolDescriptor.version has to be exactly what DefaultTools registers on this machine,
# parsed from `xcrun --find <tool>` plus `<tool> --version` by
# AppleClangSwiftToolchainHelper.parseVersion(from:). A mismatch here fails every build
# with "no tool matches", not with a missing-setting message.
#
# sdkVersion is optional everywhere it appears: absent means the machine's SDK is used
# unchecked. It is pinned here anyway, to the SDK this tree is actually developed
# against, but it is only ever checked against the machine at build time -- it does not
# select which SDK gets used.

swift.compiler.toolDescriptor.name=swiftc
swift.compiler.toolDescriptor.version=Apple Swift version 6.3.3 (swiftlang-6.3.3.1.3 clang-2100.1.1.101)
swift.compiler.toolDescriptor.platform=macOS
swift.compiler.toolDescriptor.architecture=arm64
swift.compiler.sdkVersion=26.5

swift.linker.toolDescriptor.name=swiftc
swift.linker.toolDescriptor.version=Apple Swift version 6.3.3 (swiftlang-6.3.3.1.3 clang-2100.1.1.101)
swift.linker.toolDescriptor.platform=macOS
swift.linker.toolDescriptor.architecture=arm64
swift.linker.sdkVersion=26.5

swift.packageReader.toolDescriptor.name=swift
swift.packageReader.toolDescriptor.version=Apple Swift version 6.3.3 (swiftlang-6.3.3.1.3 clang-2100.1.1.101)
swift.packageReader.toolDescriptor.platform=macOS
swift.packageReader.toolDescriptor.architecture=arm64
